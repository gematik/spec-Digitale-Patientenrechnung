     fhir:HumanName.family [ fhir:value "Mustermann" ] ;
     fhir:HumanName.given [
       fhir:value "Manfred" ;
       fhir:index -1
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "male"] ;
  fhir:Patient.birthDate [ fhir:value "1970-01-01"^^xsd:date] .

