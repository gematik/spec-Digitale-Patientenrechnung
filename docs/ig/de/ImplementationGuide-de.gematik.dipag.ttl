     fhir:ImplementationGuide.definition.grouping [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Rechnungsinhalt" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Rechnungsinhalt-Profile" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Profile fuer die strukturierten Rechnungsinhalte einer Digitalen Patientenrechnung: die Rechnung mit ihren Positionen, Diagnosen und Prozeduren, das zusammenfassende Bundle und das Rechnungsdokument sowie die an der Rechnung beteiligten Personen und Institutionen." ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Metadaten" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Metadaten- & Protokoll-Profile" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Profile fuer die Dokumentenmetadaten (DocumentReference) beim Einreichen durch die Leistungserbringer:in und im Fachdienst sowie fuer das Nutzungsprotokoll (AuditEvent)." ]
     ] ;
