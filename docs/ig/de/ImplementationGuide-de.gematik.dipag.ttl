       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Abrechnungsrelevanz von Diagnosen und Prozeduren" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Diese Extension erlaubt es einer Invoice Diagnosen oder Prozeduren, incl. Qualifier wie bspw: \"Primär-DRG\" zuzuordnen. Dies ermöglicht unter anderem das Zuordnen von Haupt- und Nebendiagnosen zu einem Account zum Zweck der DRG Erstellung." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
