            "schema": {
              "type": "string"
            },
            "description": "Ein SearchParameter auf der Ressource DocumentReference, der die Suche nach dem Text in author.display ermöglicht. Die Länge des Suchstrings ist auf 200 Zeichen begrenzt."
          }
        ]
